[
  {
    "id": "db_cooper",
    "video_subject": "El misterio de D.B. Cooper: el secuestrador que saltó de un avión con 200.000 dólares y jamás fue encontrado",
    "video_script_prompt": "Escribe un guion narrativo de 2-3 minutos, en español, tono misterioso y serio, basado ESTRICTAMENTE en hechos verificados y ampliamente documentados sobre el caso D.B. Cooper (1971, secuestro del vuelo Northwest Orient 305, rescate de 200.000 dólares, salto en paracaídas, investigación del FBI, cierre del caso en 2016). No inventes nombres, citas ni detalles que no sean de dominio público y verificados. Si alguna cifra o dato no es seguro, indícalo como teoría, no como hecho."
  },
  {
    "id": "flight_19",
    "video_subject": "El Vuelo 19: los cinco aviones de la Marina de EE.UU. que desaparecieron en el Triángulo de las Bermudas",
    "video_script_prompt": "Escribe un guion narrativo de 2-3 minutos, en español, tono misterioso y serio, basado en hechos verificados sobre la desaparición del Vuelo 19 (5 de diciembre de 1945, Marina de EE.UU., Triángulo de las Bermudas, y el hidroavión de rescate PBM Mariner que también desapareció). Distingue claramente entre hechos confirmados y teorías no probadas (errores de navegación, mal tiempo, leyendas del Triángulo). No afirmes como ciertas teorías paranormales."
  },
  {
    "id": "amelia_earhart",
    "video_subject": "Amelia Earhart: la desaparición de la aviadora más famosa de la historia sobre el Pacífico",
    "video_script_prompt": "Escribe un guion narrativo de 2-3 minutos, en español, tono misterioso y serio, basado en hechos verificados sobre la desaparición de Amelia Earhart y su navegante Fred Noonan en 1937 durante su vuelo alrededor del mundo, cerca de la isla Howland. Menciona las principales teorías investigadas (caída en el océano, isla Nikumaroro) como teorías, no como hechos confirmados."
  },
  {
    "id": "lars_mittank",
    "video_subject": "El caso de Lars Mittank: el turista alemán que desapareció tras huir aterrorizado de un hospital en Bulgaria",
    "video_script_prompt": "Escribe un guion narrativo de 2-3 minutos, en español, tono misterioso y serio, basado en hechos verificados y documentados públicamente sobre el caso de Lars Mittank (2014, Golden Sands, Bulgaria): la pelea previa, el ingreso hospitalario, las imágenes de cámaras de seguridad donde se le ve huyendo asustado, y que nunca fue encontrado. No inventes diálogos ni afirmes teorías como hechos."
  },
  {
    "id": "roanoke",
    "video_subject": "La colonia perdida de Roanoke: 115 colonos que desaparecieron sin dejar rastro en 1587",
    "video_script_prompt": "Escribe un guion narrativo de 2-3 minutos, en español, tono misterioso y serio, basado en hechos históricos verificados sobre la Colonia Perdida de Roanoke (1587), incluyendo la palabra 'CROATOAN' tallada encontrada por John White en 1590. Presenta las teorías (asimilación con nativos, enfermedad, ataque) como teorías históricas, nunca como hechos confirmados."
  }
]

name: Generar vídeo del canal

on:
  schedule:
    # 08:00 UTC = 09:00 en España (horario de invierno). Ajusta la hora si quieres.
    - cron: '0 8 * * *'
  workflow_dispatch: {}

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Clonar tu repositorio (para leer data/topics.json)
        uses: actions/checkout@v4

      - name: Instalar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Instalar ffmpeg
        run: sudo apt-get update && sudo apt-get install -y ffmpeg

      - name: Clonar MoneyPrinterTurbo
        run: git clone --depth 1 https://github.com/harry0703/MoneyPrinterTurbo.git mpt

      - name: Instalar dependencias de MoneyPrinterTurbo
        working-directory: mpt
        run: pip install -r requirements.txt

      - name: Elegir un tema al azar
        id: topic
        run: |
          python3 -c "
          import json, random
          with open('data/topics.json') as f:
              topics = json.load(f)
          t = random.choice(topics)
          print('subject=' + t['video_subject'])
          with open('topic_subject.txt', 'w') as f:
              f.write(t['video_subject'])
          with open('topic_prompt.txt', 'w') as f:
              f.write(t['video_script_prompt'])
          " >> "$GITHUB_OUTPUT"

      - name: Crear config.toml con las claves (no se sube al repositorio)
        working-directory: mpt
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
        run: |
          cat > config.toml <<EOF
          [app]
          video_source = "pixabay"
          pixabay_api_keys = ["${PIXABAY_API_KEY}"]
          llm_provider = "gemini"
          gemini_api_key = "${GEMINI_API_KEY}"
          gemini_model_name = "gemini-2.0-flash"
          subtitle_provider = "edge"
          EOF

      - name: Generar el vídeo
        working-directory: mpt
        run: |
          python3 cli.py \
            --video-subject "$(cat ../topic_subject.txt)" \
            --video-script-prompt "$(cat ../topic_prompt.txt)" \
            --video-source pixabay \
            --video-language es-ES \
            --voice-name "es-ES-AlvaroNeural" \
            --paragraph-number 4 \
            --stop-at video

      - name: Subir el vídeo generado como resultado descargable
        uses: actions/upload-artifact@v4
        with:
          name: video-generado-${{ github.run_number }}
          path: mpt/storage/tasks/**/*.mp4
          retention-days: 14
